PORT=8080
# Public base URL of THIS deployment. Used in the live-map link sent to contacts.
PUBLIC_URL=https://alerts-a.example.com
DATABASE_URL=postgres://user:password@localhost:5432/quiet_signal

# Primary SMS provider (Twilio). Replace placeholders.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM=+15550000000

# Secondary SMS provider (Telnyx), used only if Twilio errors.
TELNYX_API_KEY=replace-me
TELNYX_FROM=+15550000001

# 911 dispatch partner (Noonlight or similar). Leave blank to disable.
DISPATCH_URL=
DISPATCH_TOKEN=

# Set true only behind a proxy you control that appends the client IP to X-Forwarded-For.
TRUST_PROXY=false
RETENTION_DAYS=30
LIVE_WINDOW_HOURS=2

# Evidence journal encryption key: 32 random bytes, base64 (openssl rand -base64 32). Keep it out of the database host.
JOURNAL_KEY=

# Daily test (scripts/daily-test.ts)
SERVER_URLS=https://alerts-a.example.com,https://alerts-b.example.com
TEST_NUMBER=+15550000002
FAILURE_WEBHOOK=
