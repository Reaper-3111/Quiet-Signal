{
  "expo": {
    "name": "Skyline",
    "slug": "skyline-weather",
    "scheme": "skyline",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.example.skyline",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.example.skyline"
        ]
      },
      "appleTeamId": "REPLACE_WITH_TEAM_ID"
    },
    "android": {
      "package": "com.example.skyline",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#2c6fb7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Skyline uses the microphone for voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Skyline uses the camera to attach photos to notes."
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Skyline uses your location to show local weather and keep forecasts current in the background.",
          "locationWhenInUsePermission": "Skyline uses your location to show local weather."
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Weather",
              "label": "Weather",
              "description": "Local forecast",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Sunny",
            "ios": "./assets/icons/sunny.png",
            "android": {
              "foregroundImage": "./assets/icons/sunny-foreground.png",
              "backgroundColor": "#f2992e"
            }
          },
          {
            "name": "Storm",
            "ios": "./assets/icons/storm.png",
            "android": {
              "foregroundImage": "./assets/icons/storm-foreground.png",
              "backgroundColor": "#485463"
            }
          },
          {
            "name": "Night",
            "ios": "./assets/icons/night.png",
            "android": {
              "foregroundImage": "./assets/icons/night-foreground.png",
              "backgroundColor": "#18244a"
            }
          }
        ]
      ],
      "expo-background-task",
      "./plugins/withWearOS"
    ]
  }
}
